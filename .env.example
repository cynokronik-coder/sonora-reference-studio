# Create an OpenAI API key in your OpenAI Platform project settings.
# Keep this file local. Never prefix this variable with VITE_.
OPENAI_API_KEY=
# Model is configurable so deployments can select a supported Responses API model.
SONORA_AI_MODEL=gpt-6-astra
# Optional API server settings. The default binds to localhost only.
SONORA_AI_PORT=8787
SONORA_AI_HOST=127.0.0.1

# Supabase project connection. Public publishable keys can be exposed to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase credentials. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only key (sb_secret_...). Keep it on the API server only.
SUPABASE_SECRET_KEY=
# Optional legacy JWT alternative during migration; keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-only credentials. Create subscription Prices in Stripe first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=

# Public origin used for Stripe success/cancel/portal redirects.
SONORA_APP_URL=http://localhost:3000
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_1500=

# Keep false until Supabase/Stripe test-mode validation and paid-feature release gates pass.
SONORA_BILLING_ENABLED=false
