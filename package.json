{
  "name": "sonora-reference-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sonora Reference Studio — a reference-matched audio production environment",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ui": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
